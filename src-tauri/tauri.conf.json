{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "my-tools",
  "version": "../package.json",
  "identifier": "com.hnxyc.my-tools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "palette",
        "title": "网页快开",
        "url": "index.html",
        "width": 800,
        "height": 560,
        "visible": false,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false,
        "maximized": false,
        "skipTaskbar": true,
        "transparent": true,
        "shadow": false
      },
      {
        "label": "admin",
        "title": "管理收藏",
        "url": "index.html",
        "width": 1000,
        "height": 720,
        "visible": false,
        "decorations": true,
        "resizable": true,
        "center": true
      },
      {
        "label": "about",
        "title": "关于",
        "url": "about.html",
        "width": 400,
        "height": 280,
        "visible": false,
        "resizable": false,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
